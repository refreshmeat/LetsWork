PORT=4317

# IA local
OLLAMA_URL=http://127.0.0.1:11434
# Deixe vazio para o desktop escolher conforme o hardware.
OLLAMA_MODEL=
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_MS=45000

# RioVagas
# Quantidade de candidaturas HTTP processadas em paralelo.
RIO_APPLY_WORKERS=4

# Perguntas de formulário: regras factuais por padrão.
LETSWORK_FORM_AI=0
LETSWORK_TRAVEL_ESTIMATE=1
# Tarifa municipal do Rio usada para estimar perguntas de custo de transporte (R$)
LETSWORK_RIO_TRANSIT_FARE=5.00
# Padrão do projeto; valor explícito no currículo/perfil sempre prevalece
LETSWORK_DEFAULT_NATIONALITY=Brasileira
